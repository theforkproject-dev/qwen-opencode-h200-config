[
  "vllm",
  "serve",
  "/merged",
  "--served-model-name",
  "qwen3.8-opencode",
  "--tokenizer",
  "/tinfoil/models/qwen-adapter",
  "--dtype",
  "bfloat16",
  "--tensor-parallel-size",
  "1",
  "--language-model-only",
  "--max-model-len",
  "262144",
  "--max-num-seqs",
  "2",
  "--gpu-memory-utilization",
  "0.85",
  "--disable-extensible-kv-cache",
  "--enable-prefix-caching",
  "--enable-auto-tool-choice",
  "--tool-call-parser",
  "qwen3_xml",
  "--reasoning-parser",
  "qwen3",
  "--default-chat-template-kwargs",
  "{\"enable_thinking\":false}",
  "--host",
  "0.0.0.0",
  "--port",
  "8000",
  "--disable-log-requests",
  "--disable-log-outputs",
  "--disable-uvicorn-access-log",
  "--generation-config",
  "vllm",
  "--override-generation-config",
  "{\"temperature\":0.8,\"top_p\":1.0,\"top_k\":20,\"max_new_tokens\":32768}",
  "--max-num-batched-tokens",
  "8192"
]
